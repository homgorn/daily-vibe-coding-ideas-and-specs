# ============================================================
# Daily Vibe Coding Ideas and Specs — environment template
# Скопируй в .env и заполни значения. .env НИКОГДА не коммитится.
# ============================================================

# GitHub (обязателен для движка: без него лимиты API 60 req/h)
# https://github.com/settings/tokens → scopes: repo, workflow
GITHUB_TOKEN=ghp_xxx

# --- Telegram (модуль bots, Фаза 2) ---
# Токен от @BotFather (owner-бот)
TG_BOT_TOKEN=123456:ABC-xxx
# Твой chat_id (напиши боту /start и узнай через getUpdates)
TG_OWNER_CHAT_ID=

# --- Генерация картинок (модуль media) ---
OPENAI_API_KEY=

# --- TTS для видео (ElevenLabs) ---
ELEVENLABS_API_KEY=

# --- Почта для ингеста рассылок (модуль email, Фаза 2) ---
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=

# --- WordPress (модуль publish, Фаза 2) ---
WP_URL=
WP_USER=
WP_APP_PASSWORD=

# --- YouTube (Фаза 3) ---
YT_API_KEY=

# --- Cloudflare (зеркала-домены, позже) ---
CF_API_TOKEN=

# --- LLM-провайдеры (модуль providers): если не заполнено, используется
#     стандартный провайдер OpenChamber/OpenCode ---
LLM_PROVIDER=opencode
OPENROUTER_API_KEY=
